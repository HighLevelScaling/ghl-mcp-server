# GoHighLevel Private Integration Token (Required)
# Get yours at: GoHighLevel > Settings > Private Integrations
GHL_API_KEY=pit-xxxxxxxxxxxxxxxxxxxxxxxx

# GoHighLevel Location/Sub-Account ID (Required)
# Find at: GoHighLevel > Settings > Company
GHL_LOCATION_ID=your-location-id-here

# WindsorAI API Key (Optional - for cross-platform analytics)
# Sign up at: https://windsor.ai/
WINDSOR_API_KEY=

# Custom API Base URL (Optional - defaults to https://services.leadconnectorhq.com)
# GHL_BASE_URL=https://services.leadconnectorhq.com
